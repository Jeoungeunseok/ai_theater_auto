# ── API Keys ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── fal.ai (영상 생성 — Kling I2V 종량제) ─────────────────
# https://fal.ai → Dashboard → API Keys
FAL_KEY=your_fal_api_key_here

# ── Slack ─────────────────────────────────────────────────
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_APP_TOKEN=your_slack_app_token_here
SLACK_CHANNEL=#pangi-alerts

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=pangi
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=pangi_db
DATABASE_URL=postgresql://pangi:your_postgres_password_here@postgres:5432/pangi_db

# ── YouTube OAuth ─────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# ── TTS (팡이 단일 화자) ────────────────────────────────────
# 후보: ko-KR-InJoonNeural / ko-KR-SunHiNeural
TTS_VOICE=ko-KR-InJoonNeural
TTS_BASE_RATE=+15%
TTS_BASE_PITCH=+0Hz

# ── 배경 이미지 생성 (gpt-image-2, 편당 1~2장) ──────────────
# 캐릭터는 퍼펫 재사용이므로 배경 전용
# Options: low ($0.006/장) | medium ($0.053/장) | high ($0.211/장)
BG_IMAGE_QUALITY=medium

# ── 퍼펫 에셋 경로 ────────────────────────────────────────
PANGI_ASSET_DIR=assets/pang
PANGI_CLIPS_DIR=assets/pang/clips
PANGI_EYES_DIR=assets/pang/eyes
PANGI_BODY=assets/pang/base/body_front.png
BG_ASSET_DIR=assets/bg

# ── 비용 가드레일 ─────────────────────────────────────────
# 일일 OpenAI 비용 상한 초과 시 큐 일시 정지 ($)
DAILY_COST_LIMIT=1.0

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
