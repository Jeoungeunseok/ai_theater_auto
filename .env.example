# API Keys
OPENAI_API_KEY=your_openai_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Slack Settings
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_APP_TOKEN=your_slack_app_token_here
SLACK_CHANNEL=#ai-theater-alerts

# Database Settings
POSTGRES_USER=ai_theater
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ai_theater_db
DATABASE_URL=postgresql://ai_theater:your_postgres_password_here@postgres:5432/ai_theater_db

# YouTube OAuth
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_ACCESS_TOKEN=your_access_token_here
YOUTUBE_REFRESH_TOKEN=your_refresh_token_here

# Image Generation (gpt-image-2)
# Options: low ($0.006/장), medium ($0.053/장), high ($0.211/장)
IMAGE_QUALITY=medium

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
